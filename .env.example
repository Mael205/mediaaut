# --- LLM (ecriture des scripts) ---
ANTHROPIC_API_KEY=

# --- Banques de b-roll (gratuit, cle a creer) ---
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- YouTube Data API v3 ---
# Fichier client_secret.json telecharge depuis Google Cloud Console
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json

# --- Instagram (Graph API, app Meta en mode Developpement) ---
# IG_USER_ID : identifiant du compte professionnel, pas le pseudo.
# IG_ACCESS_TOKEN : jeton longue duree (60 jours), a regenerer avant expiration.
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- TikTok (Content Posting API, mode brouillon) ---
# Le jeton d'acces se depose dans secrets/tiktok_token.json :
#   {"access_token": "act....", "refresh_token": "..."}
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Dossier de donnees ---
# Rediriger vers un dossier partage (OneDrive, Syncthing, lecteur reseau)
# pour produire sur une machine et mettre en ligne depuis une autre.
# Laisser vide pour utiliser ./data
MEDIAAUT_DATA=
